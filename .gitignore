# Python
# Byte-compiled / optimized files
__pycache__/
*.pyc
*.pyd
*.pyo
*.egg

# Virtual environments
venv/
env/
.venv/
.env/
.env
# if you use specific names, add them here
# Example: myprojectenv/

# Distribution / packaging
build/
dist/
develop-eggs/
sdist/
var/
wheels/
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*,cover

# Django specific
# (gitignore has no inline comments: a "#" after a pattern becomes part of it)
*.log
# locale-specific settings, should not be shared
local_settings.py
# SQLite database file
db.sqlite3
# User uploaded media, managed by the server, not git
media/
# Generated static files/CDNs
static_cdn/

# Environment variables (critical for security)
# Contains environment-specific variables like secret keys
.env
.env.fr
.env.local
.env.*.local
.flaskenv

# Database dumps (transferred out-of-band, see README)
*.dump
*.sql.gz
backups/

# IDE-specific files (e.g., PyCharm, VS Code)
# PyCharm project files
.idea/
# VS Code settings and workspace files
.vscode/
*.code-workspace
# Vim swap files
*.swp
# macOS specific file
.DS_Store

# Documentation
docs/_build/

# Python specific lock files (generally recommended to include in version control, but listed here for awareness)
# Pipfile.lock
# poetry.lock
# uv.lock

# Keys and certificates
*.pem
*.key

# LaTeX build artifacts (thesis sources, figures and docs/diploma/main.pdf are tracked)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.out
*.run.xml
*.synctex
*.synctex.gz
*.synctex(busy)
*.toc
*.xdv

# Draft page previews rendered from the thesis PDF
docs/diploma/preview/

# Personal defense-preparation notes (not part of the public repository)
docs/diploma-defense*
docs/next-steps.md

# Superseded versions of the ingredient normalization report (v4 is the final one)
backend/data/ingredient_normalization_report_v[1-3].json
