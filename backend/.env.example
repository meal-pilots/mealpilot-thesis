# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PREFIX=admin/

# Postgres
POSTGRES_DB=meal_planner
POSTGRES_USER=meal_user
POSTGRES_PASSWORD=meal_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_TLS=0

# JWT
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# Throttling
DRF_ANON_THROTTLE=60/min
DRF_USER_THROTTLE=600/min
DRF_AUTH_THROTTLE=10/min
DRF_PLAN_THROTTLE=20/hour

# CORS
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=^exp://.*$

# CSRF (only used outside dev)
CSRF_TRUSTED_ORIGINS=

# Mobile app version gate
MIN_APP_VERSION_IOS=0.0.0
MIN_APP_VERSION_ANDROID=0.0.0

# Expo push
EXPO_ACCESS_TOKEN=
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.10
SENTRY_PROFILES_SAMPLE_RATE=0.10

# AWS / S3 (production only)
AWS_S3_REGION_NAME=eu-central-1
AWS_STORAGE_BUCKET_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Logging
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Boot behavior
RUN_MIGRATIONS_ON_BOOT=0
RUN_COLLECTSTATIC_ON_BOOT=1

# Backend port (compose)
BACKEND_PORT=8000
FRONTEND_PORT=5173
GIT_SHA=local-dev
