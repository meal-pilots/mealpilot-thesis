{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@features/*": [
        "src/features/*"
      ],
      "@entities/*": [
        "src/entities/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "app.config.ts",
    "*.ts",
    "*.tsx"
  ]
}